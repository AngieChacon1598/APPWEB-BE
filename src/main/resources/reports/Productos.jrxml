	<parameter name="P_STATE" class="java.math.BigDecimal">
		<defaultValueExpression><![CDATA[new java.math.BigDecimal(-1)]]></defaultValueExpression>
	</parameter>
	<queryString language="SQL">
		<![CDATA[SELECT  
    M.MENU_ID,
    M.NAME,
    M.DESCRIPTION,
    M.PRICE,
    C.NAME AS CATEGORY_NAME,
    M.CREATED_AT,
    M.STATE
FROM MENU M
JOIN CATEGORY C
    ON M.CATEGORY_ID = C.CATEGORY_ID
WHERE 
    (CAST($P{P_STATE} AS NUMBER) = -1 
     OR M.STATE = CAST($P{P_STATE} AS NUMBER))
ORDER BY M.MENU_ID]]>
	</queryString>
